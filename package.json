{
  "name": "pi-codex-computer-use",
  "version": "0.1.0",
  "description": "pi extension: run cells in the Codex REPL to drive Windows desktop apps",
  "type": "module",
  "main": "src/extension.mjs",
  "pi": {
    "extensions": [
      "src/extension.mjs"
    ],
    "skills": [
      "skills/codex-computer-use"
    ]
  },
  "files": [
    "src",
    "skills"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "test": "node --test --test-concurrency=1 --test-reporter=spec \"test/*.test.js\""
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@earendil-works/pi-coding-agent": "^1.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "dependencies": {
    "@earendil-works/pi-mcp": "^1.1.0",
    "smol-toml": "^1.9.1"
  },
  "private": true
}
