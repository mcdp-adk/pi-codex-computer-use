{
  "name": "@mcdp-adk/pi-codex-computer-use",
  "version": "0.1.1",
  "description": "pi extension: run cells in the Codex REPL to drive Windows desktop apps",
  "type": "module",
  "main": "src/extension.mjs",
  "pi": {
    "extensions": [
      "src/extension.mjs"
    ],
    "skills": [
      "skills/codex-computer-use"
    ]
  },
  "files": [
    "src",
    "skills"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "lint": "eslint . && knip",
    "test": "node test/run.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@earendil-works/pi-ai": "^1.1.0",
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "knip": "^6.41.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "dependencies": {
    "@earendil-works/pi-mcp": "^1.1.0",
    "smol-toml": "^1.9.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcdp-adk/pi-codex-computer-use.git"
  }
